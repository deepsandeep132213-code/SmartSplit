# Copy this file to .env and fill in your values.
# .env is git-ignored. NEVER commit real keys, passwords, or credentials.

# ── MySQL connection ───────────────────────────────────────────────────────
# If MySQL 8 raises "Public Key Retrieval is not allowed" (local dev only):
# DB_URL=jdbc:mysql://localhost:3306/smartsplit_db?allowPublicKeyRetrieval=true&useSSL=false
DB_URL=jdbc:mysql://localhost:3306/smartsplit_db
DB_USERNAME=
DB_PASSWORD=

# ── AI assistant (OpenAI-compatible LLM) ───────────────────────────────────
# Required for the chat assistant. Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional — override if using a different provider (e.g. Azure, local Ollama)
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ── Google Places API ──────────────────────────────────────────────────────
# Required for the "Find Nearby" feature. Enable "Places API" in Google Cloud Console.
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=
